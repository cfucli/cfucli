<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.cfucli</groupId>
        <artifactId>cfucli</artifactId>
        <version>0.4</version>
    </parent>

    <artifactId>cfucli-bundle</artifactId>
    <packaging>jar</packaging>

    <description>What ships: the cli and the window shaded into ONE jar, and on Windows the one cfucli.exe that runs it. With no arguments it opens the window; with any, it is the cli. No code of its own - app and cli stay separate modules, so the cli still builds and runs without JavaFX.</description>

    <properties>
        <!-- The cli's main, which opens the window itself when given nothing (cfucli.cli.CfuCli) -->
        <main.class>cfucli.cli.CfuCli</main.class>
        <exec.mainClass>${main.class}</exec.mainClass>
        <bundle.jar>shade/cfucli.jar</bundle.jar>
        <jrexe.skip>false</jrexe.skip>
    </properties>

    <!-- One jar per platform, because the window's JavaFX carries its natives per platform - the
         same scheme as app/pom.xml, and for the same reasons (read the comment there before
         changing it: openjfx's own -Djavafx.platform hook is broken under Maven 4). cfucli-app is
         taken with its JavaFX excluded, and the profile below supplies the target's. With no
         profile named the build machine's own natives are used and the jar is shade/cfucli.jar;
         a named target gets its own name, so a cross-build never overwrites the local one. Only the
         Windows ones build cfucli.exe. -->
    <profiles>
        <profile>
            <id>host-platform</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                    <version>${javafx.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <!-- mvn -Pwin package          Windows x64 -->
            <id>win</id>
            <properties>
                <bundle.jar>shade/cfucli-win.jar</bundle.jar>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <!-- mvn -Pmac package          Intel Mac -->
            <id>mac</id>
            <properties>
                <bundle.jar>shade/cfucli-mac.jar</bundle.jar>
                <jrexe.skip>true</jrexe.skip>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>mac</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>mac</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>mac</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <!-- mvn -Pmac-aarch64 package  Apple Silicon Mac -->
            <id>mac-aarch64</id>
            <properties>
                <bundle.jar>shade/cfucli-mac-aarch64.jar</bundle.jar>
                <jrexe.skip>true</jrexe.skip>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>mac-aarch64</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>mac-aarch64</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>mac-aarch64</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <!-- mvn -Plinux package        Linux x64 -->
            <id>linux</id>
            <properties>
                <bundle.jar>shade/cfucli-linux.jar</bundle.jar>
                <jrexe.skip>true</jrexe.skip>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>linux</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>linux</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>linux</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>io.github.cfucli</groupId>
            <artifactId>cfucli-cli</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.cfucli</groupId>
            <artifactId>cfucli-app</artifactId>
            <version>${project.version}</version>
            <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
    </dependencies>

    <build>
        <!-- cfucli.exe, when the jrexe profile of the parent pom is on. The release asset is
             cfucli-win.jar, the same bytes as the host build on Windows (release.ps1).
             Both AOT log switches are load-bearing: they move two different streams of AOT noise
             off stdout, which "exec" reserves for the command's own output. jr adds
             DisplayVMOutputToStderr by itself on the run that creates the cache, but not on the
             runs that use it, so it stays here. -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>io.github.jarrunner</groupId>
                    <artifactId>jr-maven-plugin</artifactId>
                    <configuration>
                        <name>cfucli</name>
                        <appId>io.github.cfucli:cfucli</appId>
                        <jar>${project.basedir}/${bundle.jar}</jar>
                        <jarUrl>${jrexe.release}/cfucli-win.jar</jarUrl>
                        <updateUrl>${jrexe.updates}/cfucli.json</updateUrl>
                        <fileDescription>cfucli</fileDescription>
                        <vmArgs>
                            <vmArg>--enable-native-access=ALL-UNNAMED</vmArg>
                            <vmArg>-Xlog:aot*=off</vmArg>
                            <vmArg>-XX:+DisplayVMOutputToStderr</vmArg>
                        </vmArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <!-- Keep the arcadedb-log.properties shipped by the record module, drop the engine copy
                                     whose FileHandler writes ./log/arcadedb.log into the working directory. See:
                                     the ArcadeDB notes in project-journals. -->
                                <filter>
                                    <artifact>com.arcadedb:arcadedb-engine</artifact>
                                    <excludes>
                                        <exclude>arcadedb-log.properties</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/DEPENDENCIES</exclude>
                                        <exclude>META-INF/LICENSE*</exclude>
                                        <exclude>META-INF/NOTICE*</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>project-classifier</shadedClassifierName>
                            <outputFile>${bundle.jar}</outputFile>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                    <manifestEntries>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
