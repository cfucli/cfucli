<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.cfucli</groupId>
    <artifactId>cfucli</artifactId>
    <version>0.4.2</version>
    <packaging>pom</packaging>

    <description>cfucli - one real shell that two people on different machines can both watch and type into. Both ends dial outbound to a rendezvous relay, so it crosses NAT without an inbound port, a VPN or admin rights, and it skips the relay entirely when both ends are on the same machine. Plus a CLI surface so an agent can drive the far end with exact exit codes and separated streams.</description>

    <modules>
        <module>relay</module>
        <module>record</module>
        <module>node</module>
        <module>app</module>
        <module>cli</module>
        <module>bundle</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <lettuce.version>7.7.0.RELEASE</lettuce.version>
        <jackson.version>2.21.2</jackson.version>
        <!-- From 2.0 the four datahelper modules move on one version line and the two
             arcadedbhelper modules on another, so two properties cover all six artifacts. Before
             2.0 every module published independently, which is why this needed six. -->
        <datahelper.version>2.0</datahelper.version>
        <arcadedbhelper.version>2.0</arcadedbhelper.version>
        <arcadedb.version>26.7.3</arcadedb.version>
        <gson.version>2.14.0</gson.version>
        <picocli.version>4.7.7</picocli.version>
        <slf4j.version>2.0.18</slf4j.version>
        <!-- jeditermfx 1.1.0 is the released one on Central; it was built against JavaFX 19 and
             pty4j 0.12.25. pty4j is pinned to that same 0.12.25 rather than the newer 0.13.x so
             there is one native pty binding in the tree, not two. JavaFX is taken to 25 to match
             the JDK; drop to 21 if the terminal widget turns out to touch something removed. -->
        <jeditermfx.version>1.1.0</jeditermfx.version>
        <luvjfx.version>1.0</luvjfx.version>
        <pty4j.version>0.12.25</pty4j.version>
        <javafx.version>25.0.4</javafx.version>
        <junit.version>5.11.4</junit.version>
        <surefire.version>3.5.4</surefire.version>
        <compiler.plugin.version>3.14.0</compiler.plugin.version>
        <shade.plugin.version>3.6.0</shade.plugin.version>
    </properties>

    <!-- pty4j pulls org.jetbrains.pty4j:purejavacomm, which is not on Maven Central. jeditermfx's
         own pom declares the same repository for the same reason. -->
    <repositories>
        <repository>
            <id>jetbrains-intellij-dependencies</id>
            <url>https://packages.jetbrains.team/maven/p/ij/intellij-dependencies</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.cfucli</groupId>
                <artifactId>cfucli-relay</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.cfucli</groupId>
                <artifactId>cfucli-record</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.cfucli</groupId>
                <artifactId>cfucli-node</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.datapotter</groupId>
                <artifactId>datapotter-arcadedbhelper</artifactId>
                <version>${arcadedbhelper.version}</version>
            </dependency>
            <dependency>
                <groupId>com.arcadedb</groupId>
                <artifactId>arcadedb-engine</artifactId>
                <version>${arcadedb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.techsenger.jeditermfx</groupId>
                <artifactId>jeditermfx-core</artifactId>
                <version>${jeditermfx.version}</version>
            </dependency>
            <dependency>
                <groupId>com.techsenger.jeditermfx</groupId>
                <artifactId>jeditermfx-ui</artifactId>
                <version>${jeditermfx.version}</version>
            </dependency>
            <dependency>
                <groupId>io.lettuce</groupId>
                <artifactId>lettuce-core</artifactId>
                <version>${lettuce.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-toml</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.datapotter</groupId>
                <artifactId>datapotter-datahelper-base</artifactId>
                <version>${datahelper.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.datapotter</groupId>
                <artifactId>datapotter-datahelper-annotations</artifactId>
                <version>${datahelper.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.datapotter</groupId>
                <artifactId>datapotter-datahelper-json</artifactId>
                <version>${datahelper.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>io.github.datapotter</groupId>
                                <artifactId>datapotter-datahelper-processor</artifactId>
                                <version>${datahelper.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${shade.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- The Windows launcher cfucli.exe, built by jr's maven plugin
         (github.com/jarrunner/jr) with its config, icon and version baked in. Opt-in, because
         the plugin is not on Maven Central yet, so a plain build of this repo must not need it:

             mvn -Djrexe verify                        an exe that runs the jar just built (dev)
             mvn -Djrexe -Djr.source=url verify        an exe that fetches its jar from the GitHub
                                                       release of this version - what release.ps1 ships

         A release exe carries the jar's sha256 and fetches the jar on its first run, a Java runtime
         too if none is found, and updates itself with "cfucli -Xjr:update" from the update files
         on cfucli.github.io. Output: bundle/target/jr/. Only bundle builds one - it is the jar that
         ships, the cli and the window in one - and the other modules inherit the plugin skipped. -->
    <profiles>
        <profile>
            <id>jrexe</id>
            <activation>
                <property>
                    <name>jrexe</name>
                </property>
            </activation>
            <properties>
                <jrexe.skip>true</jrexe.skip>
                <jrexe.release>https://github.com/cfucli/cfucli/releases/download/v${project.version}</jrexe.release>
                <jrexe.updates>https://cfucli.github.io/update</jrexe.updates>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.jarrunner</groupId>
                        <artifactId>jr-maven-plugin</artifactId>
                        <version>1.2.0-SNAPSHOT</version>
                        <executions>
                            <execution>
                                <!-- verify, not package: an inherited plugin runs before the module's own
                                     shade in the same phase, and would hash the previous jar -->
                                <phase>verify</phase>
                                <goals>
                                    <goal>exe</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <skip>${jrexe.skip}</skip>
                            <icon>${maven.multiModuleProjectDirectory}/pkg/cfucli.ico</icon>
                            <productName>cfucli</productName>
                            <companyName>cfucli</companyName>
                            <copyright>cfucli contributors</copyright>
                            <!-- 25: the AOT cache and the in-process JVM need it, as the installer does -->
                            <javaVersion>25+</javaVersion>
                            <jvmMode>dll</jvmMode>
                            <!-- jr's error dialog: Report issue opens a pre-filled GitHub issue (jr PRP-31) -->
                            <supportName>cfucli</supportName>
                            <supportIssues>https://github.com/cfucli/cfucli/issues</supportIssues>
                            <supportUrl>https://cfucli.github.io</supportUrl>
                            <aot>true</aot>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
