<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.cfucli</groupId>
        <artifactId>cfucli</artifactId>
        <version>0.4</version>
    </parent>

    <artifactId>cfucli-cli</artifactId>
    <packaging>jar</packaging>

    <description>cfucli.exe - the agent's surface. A thin client over the node's loopback socket, so what claude-code sends lands in the same session the human is watching. Verbs read like ssh; everything that reports state also speaks --json.</description>

    <properties>
        <main.class>cfucli.cli.CfuCli</main.class>
        <exec.mainClass>${main.class}</exec.mainClass>
        <jrexe.skip>false</jrexe.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.cfucli</groupId>
            <artifactId>cfucli-node</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- cfucli.exe, when the jrexe profile of the parent pom is on. Both AOT log switches are
             load-bearing: they move two different streams of AOT noise off stdout, which "exec"
             reserves for the command's own output. -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>io.github.jarrunner</groupId>
                    <artifactId>jr-maven-plugin</artifactId>
                    <configuration>
                        <name>cfucli</name>
                        <appId>io.github.cfucli:cfucli</appId>
                        <jar>${project.basedir}/shade/cfucli.jar</jar>
                        <jarUrl>${jrexe.release}/cfucli.jar</jarUrl>
                        <updateUrl>${jrexe.updates}/cfucli.json</updateUrl>
                        <fileDescription>cfucli</fileDescription>
                        <vmArgs>
                            <vmArg>--enable-native-access=ALL-UNNAMED</vmArg>
                            <vmArg>-Xlog:aot*=off</vmArg>
                            <vmArg>-XX:+DisplayVMOutputToStderr</vmArg>
                        </vmArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <!-- Keep the arcadedb-log.properties shipped by the record module, drop the engine copy
                                     whose FileHandler writes ./log/arcadedb.log into the working directory. See:
                                     the ArcadeDB notes in project-journals. -->
                                <filter>
                                    <artifact>com.arcadedb:arcadedb-engine</artifact>
                                    <excludes>
                                        <exclude>arcadedb-log.properties</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/DEPENDENCIES</exclude>
                                        <exclude>META-INF/LICENSE*</exclude>
                                        <exclude>META-INF/NOTICE*</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>project-classifier</shadedClassifierName>
                            <outputFile>shade/cfucli.jar</outputFile>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                    <manifestEntries>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
