# Java Runner Configuration (.jrc) for the cfucli COMMAND LINE.
#
# Not needed to share this machine - the window does that on its own. This is here so the machine
# can be re-pointed at a different relay without editing files by hand:
#   cfucli relay show
#   cfucli relay set --from thefile.txt
# and so its own recorded sessions can be read back with jobs, grep and tail.

# BOTH -Xlog:aot*=off AND -XX:+DisplayVMOutputToStderr are load-bearing, and neither covers the
# other: they move two DIFFERENT streams of AOT noise off stdout, and stdout is reserved here
# because "exec" puts the command's own output there.
vm.args=--enable-native-access=ALL-UNNAMED -Xlog:aot*=off -XX:+DisplayVMOutputToStderr

java.args=-jar cfucli.jar

# Off for the same reason as the window: this folder may not be writable.
aot=false

jvm=dll
